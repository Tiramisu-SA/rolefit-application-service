{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draftId",
    "candidateId",
    "jobId",
    "format",
    "sections",
    "approvedAt",
    "updatedAt"
  ],
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "candidateId": {
      "type": "string",
      "format": "uuid"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "format": {
      "enum": ["company", "personal"]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "meta", "bullets", "emphasized"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "enum": ["summary", "skills", "education", "experience", "project"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "meta": {
            "type": "string",
            "maxLength": 2000
          },
          "bullets": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "tailored"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "tailored": {
                  "type": "boolean"
                }
              }
            }
          },
          "emphasized": {
            "type": "boolean"
          }
        }
      }
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolefit.local/contracts/approved-resume.v1.schema.json"
}
