APP_ENV=production
UPSTREAM_MODE=live
# Per-service overrides: live | fallback | fixture
# JOB_POSTING_MODE=live
# RESUME_PREPARATION_MODE=live
# JOB_DISCOVERY_MODE=live
# CANDIDATE_PROFILE_MODE=live
# Fixture/fallback require APP_ENV=development and the local application_dev database.
PORT=3004
HOST=127.0.0.1
DATABASE_URL=postgresql://application:application-local@localhost:5433/application
DATABASE_SSL=false
# DATABASE_CA_FILE=/absolute/path/to/provider-ca.pem
RABBITMQ_URL=amqp://rolefit:rolefit-local@localhost:5672

# Submission calls: use the owner's documented ports/contracts.
JOB_POSTING_GRPC_URL=localhost:50052
RESUME_PREPARATION_GRPC_URL=localhost:50053
JOB_DISCOVERY_SERVICE_URL=http://localhost:3002
CANDIDATE_PROFILE_SERVICE_URL=http://localhost:3001
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_GRPC_TLS=false
# UPSTREAM_GRPC_CA_FILE=/absolute/path/to/provider-ca.pem

# Deadline reminders (FR-17)
REMINDER_ENABLED=true
REMINDER_INTERVAL_MS=3600000
REMINDER_WINDOW_HOURS=48
# Authorization header value Candidate Profile accepts for reminder lookups of candidate name/email
# REMINDER_PROFILE_AUTHORIZATION=
